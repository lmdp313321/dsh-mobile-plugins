{
  "name": "@dsh-mobile/snippets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "快捷提示词：把常说的话存成一句话片段，输入框左键一点就填，手机上不用再一个个字打。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": ["dsh-plugin", "mobile", "android", "snippets", "prompt"],
  "license": "MIT"
}
